{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@intentots/core": [
        "packages/core/src"
      ],
      "@intentots/provider-mock": [
        "packages/provider-mock/src"
      ],
      "@intentots/provider-openai": [
        "packages/provider-openai/src"
      ],
      "@intentots/type-engine": [
        "packages/type-engine/src"
      ],
      "@intentots/compiler": [
        "packages/compiler/src"
      ]
    }
  }
}